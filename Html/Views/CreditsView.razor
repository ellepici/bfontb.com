@* Crediti dell'app: chi l'ha fatta e con che cosa *@
<div class="settings credits">
    <h2>Credits</h2>

    <section class="set-sec" aria-labelledby="cr-app">
        <h3 class="set-h" id="cr-app">b<span class="dim">efore</span> font b<span class="dim">ook</span></h3>
        <p class="set-note">Proof the fonts in a folder without installing them. Everything happens in your browser: no file ever leaves your computer.</p>
        <dl class="cr-list">
            <dt>Design and code</dt>
            <dd>Leonardo Paolo Campan · <a href="https://ellepici.com" target="_blank" rel="noopener">ellepici.com</a></dd>
            <dt>Interface typeface</dt>
            <dd><a href="https://rsms.me/inter/" target="_blank" rel="noopener">Inter</a> by Rasmus Andersson · SIL Open Font License</dd>
            <dt>Icons</dt>
            <dd><a href="https://phosphoricons.com" target="_blank" rel="noopener">Phosphor Icons</a> by Helena Zhang and Tobias Fried · MIT</dd>
            <dt>Animated numbers</dt>
            <dd><a href="https://number-flow.barvian.me" target="_blank" rel="noopener">NumberFlow</a> by Maxwell Barvian · MIT</dd>
            <dt>Built with</dt>
            <dd>Blazor WebAssembly, .NET 10</dd>
        </dl>
    </section>

    <section class="set-sec" aria-labelledby="cr-fonts">
        <h3 class="set-h" id="cr-fonts">The typefaces you open</h3>
        <p class="set-note">They belong to their foundries and designers, and stay on your computer. The credits of each one (designer, foundry, licence) are on its style page, under “Credits”.</p>
    </section>
</div>
