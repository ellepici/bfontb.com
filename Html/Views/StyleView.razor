@* Pagina di uno stile nella colonna dei caratteri: tutti i caratteri, prova a vari corpi, crediti *@
@if (Ref is null)
{
    <p class="empty">This style is no longer in the folder. Choose a family from the list on the left.</p>
}
else
{
    var style = Ref.Style;
    var family = Ref.Family.Name;
    <div class="sv">
    <div class="sv-head">
        <div class="sv-title">
            <div class="sv-name">
                <h2>@(Ref.Variant is "Web" ? family : Ref.Variant) <span>@ShownLabel(style)</span></h2>
                @* accanto al nome, sulla destra: il file e il suo peso *@
                <span class="sv-file">@FileLine(style)</span>
                <div class="sv-acts">
                    @* i crediti si aprono come le altre tendine: il riquadro esce dal pulsante, in un'unica forma (vedi mergedPops in bfontb.js);
                       si chiude con un clic fuori, con Esc o di nuovo sul pulsante, e resta aperto passando da uno stile all'altro per confrontarli *@
                    <div class="cred-dd" @onkeydown="OnCredKey">
                        <button type="button" class="dd-btn cred-btn" aria-haspopup="dialog" aria-expanded="@(showCredits ? "true" : "false")" aria-controls="credPanel" @onclick="ToggleCredits">
                            <Icon Name="information" /><span>Credits</span><Icon Name="chevron--down" Class="dd-caret" />
                        </button>
                        @if (showCredits)
                        {
                            <div class="dd-back" @onclick="ToggleCredits"></div>
                            <div class="cred-pop" id="credPanel" role="dialog" aria-label="@($"Credits of {style.FileName}")">
                                <div class="cred-pop-h">Credits written in the file <b>@style.FileName</b></div>
                                <CreditsList Style="style" />
                                <SearchLinks Family="@family" Info="style.Info" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            @* sotto il nome: quanti caratteri ha il file (prima stava sopra l'elenco dei caratteri) *@
            @if (style.IsDemo)
            {
                <div class="sub">Sample typeface: only the basic alphabet is shown here.</div>
            }
            else if (ShownSet is { } gs)
            {
                <div class="sub">
                    <FlowNumber Value="gs.Encoded" /> encoded characters
                    @if (gs.Alternates > 0)
                    {
                        <text> · </text><FlowNumber Value="gs.Alternates" /><text> alternate forms</text>
                    }
                    @if (gs.TotalGlyphs > 0)
                    {
                        <text> · </text><FlowNumber Value="Math.Min(gs.Reachable, gs.TotalGlyphs)" /><text> of the file’s </text><FlowNumber Value="gs.TotalGlyphs" /><text> glyphs shown here</text>
                    }
                </div>
            }
            @if (style.Info?.Subset == true)
            {
                <p class="sv-note"><Icon Name="warning" /> Partial copy: this file was taken from a PDF or a website and holds only the characters used there.</p>
            }
        </div>
    </div>

    @* Scelta della variante (sottofamiglia: Condensed, Poster, Twe ITC…) e dello stile dentro la variante *@
    <div class="sv-bar">
        <div class="pick">
            <span id="lbl-variant">Variant <em>@VariantList.Count</em></span>
            <Dropdown Class="lg" Steady="true" Options="VariantOptions" Value="@Ref.Variant" Disabled="@(VariantList.Count < 2)" OnChange="OnVariant" LabelledBy="lbl-variant" />
        </div>
        <div class="pick">
            <span id="lbl-style">Style <em>@VariantStyles.Count</em></span>
            <Dropdown Class="lg" Steady="true" Options="StyleOptions" Value="@style.Path" Disabled="@(VariantStyles.Count < 2)" OnChange="OnStyle" LabelledBy="lbl-style" />
        </div>
        <div class="sv-tabs" role="tablist" aria-label="Style sections">
            <button class="tab" role="tab" aria-selected="@TabSel(Tab.Glyphs)" @onclick="() => Show(Tab.Glyphs)">Characters @if (TabCount is long n) { <span class="n"><FlowNumber Value="n" /></span> }</button>
            <button class="tab" role="tab" aria-selected="@TabSel(Tab.Proof)" @onclick="() => Show(Tab.Proof)">Proof</button>
        </div>
    </div>

    <div class="@(tab == Tab.Glyphs ? "sv-body fill" : "sv-body")">
    @if (style.Status == LoadStatus.Error)
    {
        <p class="empty">This file doesn’t open in the browser (unsupported format or damaged).</p>
    }
    else if (!style.IsDemo && !Lib.Connected)
    {
        <p class="empty">Reconnect the folder (the folder button at the top right) to see this typeface.</p>
    }
    else if (tab == Tab.Glyphs)
    {
        @if (style.IsDemo)
        {
            <GlyphExplorer Style="style" Set="null" />
        }
        else if (Set?.Error is not null && Drawable(style))
        {
            <p class="empty">@Set.Error</p>
        }
        else if (ShownSet is not null && ShownStyle is not null)
        {
            @* sempre lo stesso componente: passando a un altro stile resta il precedente, un po' spento, finché il nuovo non è pronto;
               così i numeri (caratteri, forme alternative) scorrono dal vecchio al nuovo valore invece di ricomparire *@
            <div class="@(Ready ? "gx-host" : "gx-host waiting")">
                <GlyphExplorer Style="ShownStyle" Set="ShownSet" />
            </div>
        }
        else
        {
            <p class="empty">Reading the characters in the file…</p>
        }
    }
    else if (tab == Tab.Proof)
    {
        @if (!Drawable(style))
        {
            <p class="empty">Loading the font…</p>
        }
        else
        {
            <div class="spec-sheet">
            <div class="sec-l">Size waterfall</div>
            @foreach (var size in Sizes)
            {
                <div class="wf">
                    <span>@size pt</span>
                    <div style="@StyleAt(style, size)">@Lib.TextFor(family)</div>
                </div>
            }
            <div class="sec-l">Running text</div>
            <p class="para" style="@($"{style.Css};font-size:17px;line-height:1.55")">@Paragraph</p>
            </div>
        }
    }
    </div>
    </div>
}
