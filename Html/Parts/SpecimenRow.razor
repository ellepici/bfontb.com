@* Una riga di prova: intestazione con nome (e, nel catalogo, la tendina dello spessore) e crediti, stella per il confronto, testo nel font *@
@inherits LazyFont
<div class="row">
    <div class="meta">
        @if (FamilyLink)
        {
            <button class="lnk" @onclick="() => Lib.OpenFamily(Family, Anchor)">@(LinkText ?? Family)</button>
        }
        else
        {
            <b>@(Title ?? Style.Label)</b>
        }
        @if (StyleOptions is { Count: > 0 })
        {
            @* lo spessore (lo stile) da mostrare, scelto qui senza entrare nella famiglia *@
            <Dropdown Class="sm" Options="StyleOptions" Value="@PickValue" Disabled="@(StyleOptions.Count < 2)" OnChange="OnStyle" />
        }
        <span class="meta-rest">
            @if (Extra is not null)
            {
                <span>@ExtraText</span>
            }
            @if (Style.Info?.CreditLine(!HideAuthor, !HideYear) is { Length: > 0 } credit)
            {
                <span class="cred">@credit</span>
            }
            @* del file si mostra solo il formato; il nome intero resta nel suggerimento al passaggio del mouse *@
            @if (Style.Format.Length > 0)
            {
                <span class="fmt" title="@Style.FileName">@Style.Format</span>
            }
        </span>
    </div>
    <div class="acts">
        @if (CanAnimate)
        {
            @* font variabile: il testo passa dal peso più sottile al più spesso e torna indietro, finché non lo si ferma *@
            <button class="icon-btn" title="@(paused ? "Play the weight animation" : "Pause the weight animation")"
                    aria-label="@(paused ? "Play the weight animation" : "Pause the weight animation")" @onclick="() => paused = !paused"><Icon Name="@(paused ? "play" : "pause")" /></button>
        }
    </div>
    <div class="@($"spec {SpecClass}{AnimClass}")" style="@(SpecStyle + AnimStyle)" title="Open the style page: all characters, proof and credits" @ref="specEl" @onclick="Open">@SpecText</div>
</div>
