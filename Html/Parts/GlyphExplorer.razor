@* Carattere grande a sinistra con le linee di riferimento, tutti i caratteri del file a destra *@
<div class="gx" tabindex="0" @ref="gxEl" @onkeydown="OnKey" aria-label="Characters of the style: use the arrow keys to step through them">
    <div class="gx-big">
        <div class="gx-stage" role="img" aria-label="@($"Character {Sel?.Text}, enlarged")">
        @* i nomi delle linee stanno in una colonna a sé, a sinistra, nei colori dell'interfaccia: cambiando i colori del
           carattere e dello sfondo (Colors) restano leggibili e non si mescolano al disegno *@
        <div class="gx-gutter" aria-hidden="true">
            @foreach (var l in Lines)
            {
                <span class="@($"gx-lab{(l.Strong ? " strong" : "")}{(l.Right ? " below" : "")}")" style="@($"--y:{F(l.Y)}")">@l.Label</span>
            }
        </div>
        <div class="gx-canvas" aria-hidden="true"></div>
        @* le linee sono un solo disegno che attraversa anche la colonna dei nomi: così le due parti coincidono al pixel *@
        <svg class="gx-svg" viewBox="0 0 1000 1000" aria-hidden="true">
            @foreach (var l in Lines)
            {
                <line x1="-6000" x2="7000" y1="@F(l.Y)" y2="@F(l.Y)" class="@(l.Strong ? "gx-line strong" : "gx-line")" />
            }
        </svg>
        @* il carattere è in HTML e non nel disegno SVG: Safari nell'SVG non disegna un accento da solo e sposta quelli appoggiati a uno spazio *@
        <div class="gx-glyph">
        @if (Sel is not null)
        {
            <div class="gx-sq" aria-hidden="true"><span @ref="bigText" class="gx-char" style="@BigStyle">@Sel.Text<i class="gx-bl"></i></span></div>
        }
        </div>
        </div>
        <div class="gx-info">
            <button class="gx-nav" aria-label="Previous character" @onclick="() => Step(-1)"><Icon Name="arrow--left" /></button>
            <div class="gx-what">
                <div><b>@SelCode</b> <span>@SelCategory</span></div>
                <div class="gx-grp">@SelGroup</div>
            </div>
            <button class="gx-nav" aria-label="Next character" @onclick="() => Step(1)"><Icon Name="arrow--right" /></button>
        </div>
    </div>

    <div class="gx-list">
        @* il riassunto (caratteri, forme alternative, glifi) è sotto il nome dello stile, in StyleView *@
        @foreach (var g in Data.Blocks)
        {
            <GlyphGroupView Group="g" Css="@Css" SelectedId="@(Sel?.Id ?? -1)" OnPick="Pick" FontPrefix="@CanvasPrefix" FontFamily="@CanvasFamily" Ink="Data.Ink" />
        }
        @if (Data.Features.Count > 0)
        {
            <div class="gx-part">Alternate forms (OpenType features)</div>
            @foreach (var g in Data.Features)
            {
                <GlyphGroupView Group="g" Css="@Css" SelectedId="@(Sel?.Id ?? -1)" OnPick="Pick" FontPrefix="@CanvasPrefix" FontFamily="@CanvasFamily" Ink="Data.Ink" />
            }
        }
        @if (HiddenNote is not null)
        {
            <p class="gx-sum">@HiddenNote</p>
        }
    </div>
</div>
